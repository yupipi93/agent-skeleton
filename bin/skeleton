#!/usr/bin/env python3
"""agent-skeleton CLI.

Renders the kit (kit/bundles/*, local/bundles/*) into the files each AI coding
tool reads: Claude Code, Cursor, Gemini CLI and Antigravity.

Stdlib only, Python >= 3.11. Run `bin/skeleton --help` for the command list.
Design notes live in docs/architecture.md; the bundle contract in
docs/customization.md.
"""
from __future__ import annotations

import os
import sys

MIN_PYTHON = (3, 11)


def _ensure_python() -> None:
    """Re-exec under a newer python3.X when started by an older interpreter.

    macOS ships python3 3.9 with the Command Line Tools, so `#!/usr/bin/env
    python3` may land here first. This function must stay parseable by old
    Python versions, which is why the rest of the file avoids 3.10+ syntax.
    """
    if sys.version_info >= MIN_PYTHON:
        return
    import shutil

    if not os.environ.get("SKELETON_REEXEC"):
        for minor in range(30, MIN_PYTHON[1] - 1, -1):
            name = "python3.%d" % minor
            candidates = [shutil.which(name)]
            candidates += [os.path.join(d, name) for d in ("/opt/homebrew/bin", "/usr/local/bin")]
            for exe in candidates:
                if exe and os.access(exe, os.X_OK):
                    os.environ["SKELETON_REEXEC"] = "1"
                    os.execv(exe, [exe, os.path.abspath(__file__)] + sys.argv[1:])
    sys.stderr.write(
        "bin/skeleton needs Python >= %d.%d (found %s). Install one with "
        "`brew install python@3.12` or run bin/install-mac.sh.\n"
        % (MIN_PYTHON[0], MIN_PYTHON[1], sys.version.split()[0])
    )
    sys.exit(1)


if __name__ == "__main__":
    _ensure_python()

