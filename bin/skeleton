# --------------------------------------------------------------------------- #
# Output helpers
# --------------------------------------------------------------------------- #

class Style:
    def __init__(self, enabled: bool):
        self.enabled = enabled

    def _c(self, code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if self.enabled else text

    def bold(self, t: str) -> str:
        return self._c("1", t)

    def dim(self, t: str) -> str:
        return self._c("2", t)

    def green(self, t: str) -> str:
        return self._c("32", t)

    def yellow(self, t: str) -> str:
        return self._c("33", t)

    def red(self, t: str) -> str:
        return self._c("31", t)

    def cyan(self, t: str) -> str:
        return self._c("36", t)


STYLE = Style(False)


def info(msg: str) -> None:
    print(msg)


def warn(msg: str) -> None:
    print(STYLE.yellow("⚠️  " + msg), file=sys.stderr)


def fail(msg: str, code: int = 1) -> None:
    print(STYLE.red("❌ " + msg), file=sys.stderr)
    raise SystemExit(code)


# --------------------------------------------------------------------------- #
# Frontmatter: a tiny parser for the YAML subset used by SKILL.md and rules
# --------------------------------------------------------------------------- #

class FrontmatterError(ValueError):
    pass


_KEY_RE = re.compile(r"^([A-Za-z0-9_.-]+)[ \t]*:(?:[ \t]+(.*)|[ \t]*)$")
_BLOCK_INDICATORS = ("|", ">", "|-", ">-", "|+", ">+")


def split_frontmatter(text: str) -> tuple[str | None, str]:
    """Return (frontmatter_block, body). frontmatter_block is None when absent."""
    lines = text.split("\n")
    if not lines or lines[0].rstrip() != "---":
        return None, text
    for i in range(1, len(lines)):
        if lines[i].rstrip() == "---":
            return "\n".join(lines[1:i]), "\n".join(lines[i + 1:])
    raise FrontmatterError("unterminated frontmatter: missing closing '---'")


def _split_commas(s: str) -> list[str]:
    parts, buf, quote = [], [], ""
    for ch in s:
        if quote:
            buf.append(ch)
            if ch == quote:
                quote = ""
        elif ch in "\"'":
            quote = ch
            buf.append(ch)
        elif ch == ",":
            parts.append("".join(buf))
            buf = []
        else:
            buf.append(ch)
    if quote:
        raise FrontmatterError("unterminated quote in inline list")
    parts.append("".join(buf))
    return [p for p in parts if p.strip()]


def parse_scalar(raw: str, where: str = "") -> Any:
    s = raw.strip()
    if s == "":
        return ""
    if s[0] == '"':
        if len(s) < 2 or not s.endswith('"'):
            raise FrontmatterError(f"{where}unterminated double-quoted string")
        try:
            return json.loads(s)
        except json.JSONDecodeError as exc:
            raise FrontmatterError(f"{where}bad double-quoted string: {exc}") from None
    if s[0] == "'":
        if len(s) < 2 or not s.endswith("'"):
            raise FrontmatterError(f"{where}unterminated single-quoted string")
        return s[1:-1].replace("''", "'")
    if s[0] == "[":
        if not s.endswith("]"):
            raise FrontmatterError(f"{where}unterminated inline list")
        inner = s[1:-1].strip()
        return [parse_scalar(p, where) for p in _split_commas(inner)] if inner else []
    if s[0] == "{":
        raise FrontmatterError(f"{where}inline maps are not supported; use an indented block")
    if " #" in s:
        s = s.split(" #", 1)[0].rstrip()
    if s in ("true", "True"):
        return True
    if s in ("false", "False"):
        return False
    if s in ("null", "~"):
        return None
    if re.fullmatch(r"-?[0-9]+", s):
        return int(s)
    return s


def _fold(text: str) -> str:
    paragraphs = re.split(r"\n\s*\n", text)
    return "\n".join(" ".join(p.split()) for p in paragraphs)


def parse_frontmatter(block: str) -> dict[str, Any]:
    """Parse the subset: scalars, quoted strings, inline lists, block lists,
    one-level nested maps, block scalars (| and >) and folded plain scalars."""
    data: dict[str, Any] = {}
    lines = block.split("\n")
    i = 0

    def indented(idx: int) -> bool:
        line = lines[idx]
        return line.startswith((" ", "\t")) or not line.strip()

    while i < len(lines):
        line = lines[i]
        where = f"frontmatter line {i + 2}: "
        if not line.strip() or line.lstrip().startswith("#"):
            i += 1
            continue
        if line[0] in " \t":
            raise FrontmatterError(f"{where}unexpected indentation")
        m = _KEY_RE.match(line)
        if not m:
            raise FrontmatterError(f"{where}expected 'key: value'")
        key, rest = m.group(1), (m.group(2) or "").strip()
        if key in data:
            raise FrontmatterError(f"{where}duplicate key '{key}'")
        i += 1
        if rest in _BLOCK_INDICATORS:
            chunk = []
            while i < len(lines) and indented(i):
                chunk.append(lines[i])
                i += 1
            text = textwrap.dedent("\n".join(chunk)).strip("\n")
            data[key] = _fold(text) if rest.startswith(">") else text
            continue
        if rest == "" or rest.startswith("#"):
            items: list[Any] = []
            mapping: dict[str, Any] = {}
            while i < len(lines) and indented(i):
                sub = lines[i].strip()
                sub_where = f"frontmatter line {i + 2}: "
                i += 1
                if not sub or sub.startswith("#"):
                    continue
                if sub == "-" or sub.startswith("- "):
                    if mapping:
                        raise FrontmatterError(f"{sub_where}cannot mix list items and keys")
                    items.append(parse_scalar(sub[1:], sub_where))
                    continue
                mm = _KEY_RE.match(sub)
                if not mm or items:
                    raise FrontmatterError(f"{sub_where}expected '- item' or 'key: value'")
                mapping[mm.group(1)] = parse_scalar(mm.group(2) or "", sub_where)
            data[key] = items if items else (mapping if mapping else None)
            continue
        value = parse_scalar(rest, where)
        if isinstance(value, str) and rest[0] not in "\"'[":
            # Plain scalar continued on indented lines (folded with spaces).
            extra = []
            while i < len(lines) and lines[i].strip() and lines[i].startswith((" ", "\t")):
                extra.append(lines[i].strip())
                i += 1
            if extra:
                value = " ".join([value] + extra)
        data[key] = value
    return data


def read_frontmatter(text: str) -> tuple[dict[str, Any] | None, str]:
    block, body = split_frontmatter(text)
    if block is None:
        return None, body
    return parse_frontmatter(block), body


def yaml_scalar(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    return json.dumps(str(value), ensure_ascii=False)


def patch_frontmatter(text: str, set_keys: dict[str, Any], remove_keys: set[str]) -> str:
    """Textually set/remove top-level keys, keeping everything else verbatim."""
    lines = text.split("\n")
    if not lines or lines[0].rstrip() != "---":
        raise FrontmatterError("no frontmatter to patch")
    end = next((i for i in range(1, len(lines)) if lines[i].rstrip() == "---"), None)
    if end is None:
        raise FrontmatterError("unterminated frontmatter")
    drop = set(remove_keys) | set(set_keys)
    out, skipping = [], False
    for line in lines[1:end]:
        m = _KEY_RE.match(line) if line and line[0] not in " \t" else None
        if m:
            skipping = m.group(1) in drop
        elif line.strip() and line[0] not in " \t":
            skipping = False
        if not skipping:
            out.append(line)
    while out and not out[-1].strip():
        out.pop()
    for k, v in set_keys.items():
        out.append(f"{k}: {yaml_scalar(v)}")
    return "\n".join([lines[0]] + out + lines[end:])


# --------------------------------------------------------------------------- #
# Minimal TOML writer (for skeleton.local.toml edits)
# --------------------------------------------------------------------------- #

_BARE_KEY = re.compile(r"^[A-Za-z0-9_-]+$")
_TABLE_RE = re.compile(r"^\s*\[\s*([^\[\]]+?)\s*\]\s*(?:#.*)?$")
_ANY_TABLE_RE = re.compile(r"^\s*\[")


def toml_key(key: str) -> str:
    return key if _BARE_KEY.match(key) else json.dumps(key, ensure_ascii=False)


def toml_value(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(v) for v in value) + "]"
    if isinstance(value, dict):
        if not value:
            return "{}"
        return "{ " + ", ".join(f"{toml_key(k)} = {toml_value(v)}" for k, v in value.items()) + " }"
    raise TypeError(f"unsupported TOML value: {value!r}")


def _norm_table_name(raw: str) -> str:
    parts = [p.strip().strip('"').strip("'") for p in raw.split(".")]
    return ".".join(parts)


def _find_section(lines: list[str], table: str) -> tuple[int, int] | None:
    """Return (header_index, end_index_exclusive) of [table], or None."""
    start = None
    for i, line in enumerate(lines):
        m = _TABLE_RE.match(line)
        if start is None:
            if m and not line.lstrip().startswith("[[") and _norm_table_name(m.group(1)) == table:
                start = i
        elif _ANY_TABLE_RE.match(line):
            return start, i
    if start is None:
        return None
    return start, len(lines)


def _key_line_re(key: str) -> re.Pattern[str]:
    k = re.escape(key)
    return re.compile(rf"^\s*(?:{k}|\"{k}\"|'{k}')\s*=")


def _trailing_comment(line: str) -> str:
    for pos in range(len(line) - 1, -1, -1):
        if line[pos] == "#":
            try:
                tomllib.loads(line[:pos])
            except tomllib.TOMLDecodeError:
                continue
            return "  " + line[pos:].strip()
    return ""


def toml_set_key(text: str, table: str, key: str, value: Any) -> str:
    lines = text.split("\n")
    new_line = f"{toml_key(key)} = {toml_value(value)}"
    section = _find_section(lines, table)
    if section is None:
        base = text if text.endswith("\n") or text == "" else text + "\n"
        sep = "\n" if base.strip() else ""
        return f"{base}{sep}[{table}]\n{new_line}\n"
    start, end = section
    key_re = _key_line_re(key)
    for i in range(start + 1, end):
        if key_re.match(lines[i]):
            try:
                tomllib.loads(lines[i])
            except tomllib.TOMLDecodeError:
                raise ValueError(
                    f"cannot edit multi-line value of '{key}' in [{table}]; edit skeleton.local.toml by hand"
                ) from None
            lines[i] = new_line + _trailing_comment(lines[i])
            return "\n".join(lines)
    insert_at = end
    while insert_at - 1 > start and not lines[insert_at - 1].strip():
        insert_at -= 1
    lines.insert(insert_at, new_line)
    return "\n".join(lines)


def toml_remove_key(text: str, table: str, key: str) -> str:
    lines = text.split("\n")
    section = _find_section(lines, table)
    if section is None:
        return text
    start, end = section
    key_re = _key_line_re(key)
    for i in range(start + 1, end):
        if key_re.match(lines[i]):
            del lines[i]
            end -= 1
            break
    else:
        return text
    body = [ln for ln in lines[start + 1:end] if ln.strip()]
    if not body:
        # Drop the now-empty table and the blank line that preceded it.
        del lines[start:end]
        if start > 0 and not lines[start - 1].strip():
            del lines[start - 1]
        result = "\n".join(lines)
        return result if result.endswith("\n") or not result else result + "\n"
    return "\n".join(lines)


# --------------------------------------------------------------------------- #
# Model
# --------------------------------------------------------------------------- #

@dataclass
class Skill:
    name: str
    bundle: str
    path: Path
    meta: dict[str, Any] = field(default_factory=dict)
    error: str | None = None


@dataclass
class Rule:
    name: str
    bundle: str
    path: Path | None
    meta: dict[str, Any] = field(default_factory=dict)
    body: str = ""
    error: str | None = None

    @property
    def apply(self) -> str:
        return str(self.meta.get("apply", ""))

    @property
    def globs(self) -> list[str]:
        g = self.meta.get("globs") or []
        if isinstance(g, str):
            g = [x.strip() for x in g.split(",") if x.strip()]
        return [str(x) for x in g]

    @property
    def description(self) -> str:
        return str(self.meta.get("description", "") or "")


@dataclass
class Hook:
    id: str
    bundle: str
    event: str
    run: str
    timeout_s: int = 30
    tools: list[str] | None = None
    match: dict[str, Any] = field(default_factory=dict)
    args: list[str] = field(default_factory=list)
    fail_closed: bool = False
    description: str = ""


@dataclass
class McpServer:
    name: str
    bundle: str
    spec: dict[str, Any]


@dataclass
class Bundle:
    name: str
    path: Path
    local: bool
    meta: dict[str, Any] = field(default_factory=dict)
    skills: list[Skill] = field(default_factory=list)
    rules: list[Rule] = field(default_factory=list)
    hooks: list[Hook] = field(default_factory=list)
    mcp: list[McpServer] = field(default_factory=list)
    errors: list[str] = field(default_factory=list)

    @property
    def emoji(self) -> str:
        return str(self.meta.get("emoji", "📦"))

    @property
    def title(self) -> str:
        return str(self.meta.get("title", self.name))

    @property
    def description(self) -> str:
        return str(self.meta.get("description", ""))


@dataclass
class ResolvedSkill:
    skill: Skill
    enabled: bool
    source: Path                   # directory actually linked (kit or override)
    meta: dict[str, Any]           # frontmatter of the source
    invocation: str | None         # override from skeleton.local.toml
    overridden: bool = False

    @property
    def needs_render(self) -> bool:
        return self.invocation is not None

    @property
    def user_only(self) -> bool:
        if self.invocation == "user":
            return True
        if self.invocation in ("auto", "model"):
            return False
        return self.meta.get("disable-model-invocation") is True


@dataclass
class State:
    root: Path
    config: dict[str, Any]
    tools: list[str]
    bundles: dict[str, Bundle]
    bundle_on: dict[str, bool]
    skills: list[ResolvedSkill]
    rules: list[tuple[Rule, bool]]
    hooks: list[tuple[Hook, bool]]
    mcp: list[tuple[McpServer, bool]]
    warnings: list[str]

    def enabled_skills(self) -> list[ResolvedSkill]:
        return [s for s in self.skills if s.enabled]

    def enabled_rules(self) -> list[Rule]:
        return [r for r, on in self.rules if on and not r.error and r.apply in APPLY_MODES]

    def enabled_hooks(self) -> list[Hook]:
        return [h for h, on in self.hooks if on]

    def enabled_mcp(self) -> list[McpServer]:
        return [m for m, on in self.mcp if on]


# --------------------------------------------------------------------------- #
# Loading
# --------------------------------------------------------------------------- #

def deep_merge(base: dict[str, Any], over: dict[str, Any]) -> dict[str, Any]:
    out = copy.deepcopy(base)
    for k, v in over.items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = deep_merge(out[k], v)
        else:
            out[k] = copy.deepcopy(v)
    return out


PERMISSION_LISTS = ("allow", "ask", "deny")


def apply_permission_adds(settings: dict[str, Any]) -> dict[str, Any]:
    """Union `<list>_add` into `<list>` under settings.permissions (allow, ask, deny).

    Order-preserving and de-duplicated; the `_add` keys never reach the output. A plain
    `allow` / `ask` / `deny` still replaces the kit list (the adds apply on top of it)."""
    perms = settings.get("permissions")
    if not isinstance(perms, dict):
        return settings
    for key in PERMISSION_LISTS:
        add_key = f"{key}_add"
        if add_key not in perms:
            continue
        add = perms.pop(add_key)
        base = perms.get(key, [])
        for name, val in ((add_key, add), (key, base)):
            if not (isinstance(val, list) and all(isinstance(x, str) for x in val)):
                fail(f"[settings.claude.permissions] {name} must be a list of strings")
        merged: list[str] = []
        for item in base + add:
            if item not in merged:
                merged.append(item)
        perms[key] = merged
    return settings


def merge_hooks(settings: dict[str, Any], hooks: dict[str, list]) -> None:
    """Append rendered hooks to the template's own hooks, event by event."""
    if not hooks:
        return
    merged = settings.get("hooks", {}) if isinstance(settings.get("hooks"), dict) else {}
    for ev, entries in hooks.items():
        merged.setdefault(ev, []).extend(entries)
    settings["hooks"] = merged


def load_toml_file(path: Path) -> dict[str, Any]:
    try:
        with path.open("rb") as f:
            return tomllib.load(f)
    except tomllib.TOMLDecodeError as exc:
        fail(f"{path.name}: invalid TOML: {exc}")
    return {}


def load_config(root: Path) -> dict[str, Any]:
    base = load_toml_file(root / "skeleton.toml") if (root / "skeleton.toml").exists() else {}
    local_path = root / "skeleton.local.toml"
    local = load_toml_file(local_path) if local_path.exists() else {}
    return deep_merge(base, local)


def _load_skill(bundle: str, d: Path) -> Skill:
    skill = Skill(name=d.name, bundle=bundle, path=d)
    md = d / "SKILL.md"
    try:
        meta, _ = read_frontmatter(md.read_text(encoding="utf-8"))
        if meta is None:
            skill.error = "SKILL.md has no frontmatter"
        else:
            skill.meta = meta
    except (OSError, UnicodeDecodeError, FrontmatterError) as exc:
        skill.error = f"SKILL.md: {exc}"
    return skill


def _load_rule(bundle: str, path: Path) -> Rule:
    rule = Rule(name=path.stem, bundle=bundle, path=path)
    try:
        meta, body = read_frontmatter(path.read_text(encoding="utf-8"))
        if meta is None:
            rule.error = "rule has no frontmatter (needs description and apply)"
        else:
            rule.meta = meta
        rule.body = body.strip("\n") + "\n"
    except (OSError, UnicodeDecodeError, FrontmatterError) as exc:
        rule.error = str(exc)
    return rule


def load_bundle(path: Path, local: bool) -> Bundle:
    b = Bundle(name=path.name, path=path, local=local)
    manifest = path / "bundle.toml"
    if manifest.exists():
        try:
            with manifest.open("rb") as f:
                b.meta = tomllib.load(f)
        except tomllib.TOMLDecodeError as exc:
            b.errors.append(f"bundle.toml: {exc}")
    else:
        b.errors.append("missing bundle.toml")
    skills_dir = path / "skills"
    if skills_dir.is_dir():
        for d in sorted(skills_dir.iterdir()):
            if d.is_dir() and not d.name.startswith("."):
                if (d / "SKILL.md").exists():
                    b.skills.append(_load_skill(b.name, d))
                else:
                    b.errors.append(f"skills/{d.name}: missing SKILL.md")
    rules_dir = path / "rules"
    if rules_dir.is_dir():
        for f in sorted(rules_dir.glob("*.md")):
            b.rules.append(_load_rule(b.name, f))
    hooks_file = path / "hooks.toml"
    if hooks_file.exists():
        try:
            with hooks_file.open("rb") as f:
                data = tomllib.load(f)
            for i, h in enumerate(data.get("hook", [])):
                if not isinstance(h, dict):
                    b.errors.append(f"hooks.toml: [[hook]] #{i + 1} is not a table")
                    continue
                tools = h.get("tools")
                b.hooks.append(Hook(
                    id=str(h.get("id", f"{b.name}-hook-{i + 1}")),
                    bundle=b.name,
                    event=str(h.get("event", "")),
                    run=str(h.get("run", "")),
                    timeout_s=int(h.get("timeout_s", 30)),
                    tools=[str(t) for t in tools] if isinstance(tools, list) else None,
                    match=dict(h.get("match", {}) or {}),
                    args=[str(a) for a in h.get("args", [])],
                    fail_closed=bool(h.get("fail_closed", False)),
                    description=str(h.get("description", "")),
                ))
        except (tomllib.TOMLDecodeError, ValueError, TypeError) as exc:
            b.errors.append(f"hooks.toml: {exc}")
    mcp_file = path / "mcp.toml"
    if mcp_file.exists():
        try:
            with mcp_file.open("rb") as f:
                data = tomllib.load(f)
            for name, spec in sorted((data.get("server") or {}).items()):
                if isinstance(spec, dict):
                    b.mcp.append(McpServer(name=name, bundle=b.name, spec=dict(spec)))
                else:
                    b.errors.append(f"mcp.toml: [server.{name}] is not a table")
        except tomllib.TOMLDecodeError as exc:
            b.errors.append(f"mcp.toml: {exc}")
    return b


def discover_bundles(root: Path, warnings: list[str]) -> dict[str, Bundle]:
    bundles: dict[str, Bundle] = {}
    for base, local in ((root / "kit" / "bundles", False), (root / "local" / "bundles", True)):
        if not base.is_dir():
            continue
        for d in sorted(base.iterdir()):
            if not d.is_dir() or d.name.startswith((".", "_")):
                continue
            if local and d.name in bundles:
                warnings.append(f"local bundle '{d.name}' shadows the kit bundle of the same name")
            bundles[d.name] = load_bundle(d, local)
    return bundles


def _expand_path(root: Path, value: str) -> Path:
    p = Path(os.path.expanduser(value))
    if not p.is_absolute():
        p = root / p
    return p.resolve()


def _cfg_table(config: dict[str, Any], name: str) -> dict[str, Any]:
    t = config.get(name, {})
    return t if isinstance(t, dict) else {}


def bundle_default(state_config: dict[str, Any], b: Bundle) -> bool:
    """Value of a bundle without skeleton.local.toml (used to minimise edits)."""
    if b.local:
        return True
    return bool(b.meta.get("default_enabled", False))


def resolve_state(root: Path, tools_override: list[str] | None = None) -> State:
    warnings: list[str] = []
    config = load_config(root)
    tools = tools_override if tools_override is not None else list(config.get("tools", TOOLS))
    unknown = [t for t in tools if t not in TOOLS]
    if unknown:
        fail(f"unknown tool(s): {', '.join(unknown)}. Valid: {', '.join(TOOLS)}")
    bundles = discover_bundles(root, warnings)
    cfg_bundles = _cfg_table(config, "bundles")
    for name in cfg_bundles:
        if name not in bundles:
            warnings.append(f"[bundles] lists unknown bundle '{name}'")

    bundle_on: dict[str, bool] = {}
    for name, b in bundles.items():
        v = cfg_bundles.get(name)
        if isinstance(v, bool):
            bundle_on[name] = v
        else:
            bundle_on[name] = bundle_default(config, b)
    for name, b in bundles.items():
        if bundle_on[name] and not b.errors:
            for req in b.meta.get("requires", []) or []:
                if not bundle_on.get(req, False):
                    warnings.append(f"bundle '{name}' requires '{req}', which is not enabled")

    cfg_skills = _cfg_table(config, "skills")
    cfg_overrides = _cfg_table(config, "overrides")
    known_skills: set[str] = set()
    resolved: list[ResolvedSkill] = []
    seen: dict[str, str] = {}
    for b in bundles.values():
        for sk in b.skills:
            known_skills.add(sk.name)
            entry = cfg_skills.get(sk.name)
            explicit: bool | None = None
            invocation: str | None = None
            if isinstance(entry, bool):
                explicit = entry
            elif isinstance(entry, dict):
                if isinstance(entry.get("enabled"), bool):
                    explicit = entry["enabled"]
                if entry.get("invocation") is not None:
                    invocation = str(entry["invocation"])
                    if invocation not in INVOCATIONS:
                        warnings.append(
                            f"[skills] {sk.name}: invocation must be one of {', '.join(INVOCATIONS)}; ignored")
                        invocation = None
            enabled = explicit if explicit is not None else bundle_on[b.name]
            if sk.error:
                if enabled:
                    warnings.append(f"skill '{sk.name}' skipped: {sk.error}")
                enabled = False
            source, meta, overridden = sk.path, sk.meta, False
            if sk.name in cfg_overrides:
                opath = _expand_path(root, str(cfg_overrides[sk.name]))
                if (opath / "SKILL.md").is_file():
                    try:
                        ometa, _ = read_frontmatter((opath / "SKILL.md").read_text(encoding="utf-8"))
                        source, meta, overridden = opath, ometa or {}, True
                    except (OSError, FrontmatterError) as exc:
                        warnings.append(f"[overrides] {sk.name}: {exc}; using the kit copy")
                else:
                    warnings.append(f"[overrides] {sk.name}: {opath} has no SKILL.md; using the kit copy")
            if enabled and sk.name in seen:
                warnings.append(
                    f"skill '{sk.name}' exists in bundles '{seen[sk.name]}' and '{b.name}'; '{b.name}' wins")
                resolved = [r for r in resolved if not (r.skill.name == sk.name and r.enabled)]
            if enabled:
                seen[sk.name] = b.name
            resolved.append(ResolvedSkill(sk, enabled, source, meta, invocation, overridden))
    for name in cfg_overrides:
        if name not in known_skills:
            warnings.append(f"[overrides] '{name}' is not a kit skill; add new skills under local/bundles/<b>/skills")
    for name in cfg_skills:
        if name not in known_skills:
            warnings.append(f"[skills] lists unknown skill '{name}'")

    cfg_rules = _cfg_table(config, "rules")
    rules: list[tuple[Rule, bool]] = []
    for b in bundles.values():
        for r in b.rules:
            v = cfg_rules.get(r.name)
            on = v if isinstance(v, bool) else bundle_on[b.name]
            if on and r.error:
                warnings.append(f"rule '{r.name}' skipped: {r.error}")
            rules.append((r, on))
    profile = _user_profile_rule(config)
    if profile is not None:
        rules.append((profile, True))

    cfg_hooks = _cfg_table(config, "hooks")
    hooks: list[tuple[Hook, bool]] = []
    for b in bundles.values():
        for h in b.hooks:
            v = cfg_hooks.get(h.id)
            hooks.append((h, v if isinstance(v, bool) else bundle_on[b.name]))

    cfg_mcp = _cfg_table(config, "mcp")
    servers: list[tuple[McpServer, bool]] = []
    known_mcp: set[str] = set()
    for b in bundles.values():
        for m in b.mcp:
            known_mcp.add(m.name)
            over = cfg_mcp.get(m.name, {})
            spec = dict(m.spec)
            on = bundle_on[b.name]
            if isinstance(over, dict):
                if isinstance(over.get("enabled"), bool):
                    on = over["enabled"]
                spec.update({k: v for k, v in over.items() if k != "enabled"})
            servers.append((McpServer(m.name, b.name, spec), on))
    for name, over in sorted(cfg_mcp.items()):
        if name in known_mcp or not isinstance(over, dict):
            continue
        if over.get("command") or over.get("url"):
            spec = {k: v for k, v in over.items() if k != "enabled"}
            servers.append((McpServer(name, "skeleton.local.toml", spec), over.get("enabled", True) is not False))
        else:
            warnings.append(f"[mcp.{name}] is not a kit server and has no command or url")

    return State(root, config, tools, bundles, bundle_on, resolved, rules, hooks, servers, warnings)


def _user_profile_rule(config: dict[str, Any]) -> Rule | None:
    user = _cfg_table(config, "user")
    name = str(user.get("name", "") or "").strip()
    lang = str(user.get("language", "en") or "en").strip()
    lines = []
    if name:
        lines.append(f"- The user's name is {name}.")
    if lang and lang != "en":
        lines.append(f"- Reply in the language with code `{lang}` unless the user writes in another "
                     "language or asks otherwise. Files, commits and code comments stay in English.")
    if not lines:
        return None
    body = "# User profile\n\n" + "\n".join(lines) + "\n"
    meta = {"description": "User profile from skeleton.local.toml ([user] table).", "apply": "always"}
    return Rule(name="skeleton-user-profile", bundle="skeleton.local.toml", path=None, meta=meta, body=body)


# --------------------------------------------------------------------------- #
# Rendering: build a plan of files and links
# --------------------------------------------------------------------------- #

class Plan:
    def __init__(self) -> None:
        self.entries: dict[str, tuple[str, str]] = {}

    def file(self, rel: str, content: str) -> None:
        self.entries[rel] = ("file", content)

    def link(self, rel: str, target: str) -> None:
        self.entries[rel] = ("link", target)


def link_target(root: Path, link_rel: str, target: Path) -> str:
    target = Path(os.path.abspath(target))
    try:
        target.relative_to(root)
    except ValueError:
        return str(target)
    return os.path.relpath(target, (root / link_rel).parent)


def dump_json(data: Any) -> str:
    return json.dumps(data, indent=2, ensure_ascii=False) + "\n"


def _rel(root: Path, p: Path) -> str:
    try:
        return p.relative_to(root).as_posix()
    except ValueError:
        return str(p)


def _source_note(root: Path, rule: Rule) -> str:
    src = _rel(root, rule.path) if rule.path else rule.bundle
    return f"<!-- {MARKER}. Source: {src} -->"


def render_rule_cursor(root: Path, rule: Rule) -> str:
    fm = [f"description: {yaml_scalar(rule.description)}"]
    if rule.apply == "glob":
        fm.append(f"globs: {','.join(rule.globs)}")
        fm.append("alwaysApply: false")
    elif rule.apply == "always":
        fm.append("alwaysApply: true")
    else:
        fm.append("alwaysApply: false")
    return "---\n" + "\n".join(fm) + "\n---\n" + _source_note(root, rule) + "\n\n" + rule.body


def render_rule_claude(root: Path, rule: Rule) -> str | None:
    if rule.apply == "manual":
        return None
    head = ""
    if rule.apply == "glob":
        head = "---\npaths:\n" + "".join(f"  - {json.dumps(g)}\n" for g in rule.globs) + "---\n"
    return head + _source_note(root, rule) + "\n\n" + rule.body


def render_rule_antigravity(root: Path, rule: Rule) -> str:
    trigger = {"always": "always_on", "glob": "glob", "manual": "manual"}[rule.apply]
    fm = [f"trigger: {trigger}", f"description: {yaml_scalar(rule.description)}"]
    if rule.apply == "glob":
        fm.append(f"globs: {','.join(rule.globs)}")
    return "---\n" + "\n".join(fm) + "\n---\n" + _source_note(root, rule) + "\n\n" + rule.body


def render_gemini_rules(root: Path, rules: list[Rule]) -> str | None:
    always = [r for r in rules if r.apply == "always"]
    scoped = [r for r in rules if r.apply == "glob"]
    if not always and not scoped:
        return None
    out = [
        f"<!-- {MARKER}. Source: kit/bundles/*/rules and local/bundles/*/rules -->",
        "",
        "# Workspace rules",
        "",
        "These rules come from the agent-skeleton kit. They apply to every task in this workspace.",
        "",
    ]
    for r in always:
        out += ["---", "", _source_note(root, r), "", r.body.rstrip("\n"), ""]
    if scoped:
        out += ["---", "", "# Scoped rules", "",
                "Each rule below applies only when you read or edit files matching its globs.", ""]
        for r in scoped:
            globs = ", ".join(f"`{g}`" for g in r.globs)
            out += ["---", "", _source_note(root, r), "", f"> Applies to files matching: {globs}", "",
                    r.body.rstrip("\n"), ""]
    return "\n".join(out).rstrip("\n") + "\n"


def hook_command(root: Path, state_bundles: dict[str, Bundle], hook: Hook, tool: str) -> str:
    script = state_bundles[hook.bundle].path / hook.run
    rel = _rel(root, script)
    quoted = rel if re.fullmatch(r"[A-Za-z0-9_./-]+", rel) else shlex.quote(rel)
    parts = [HOOK_PREFIX[tool] + quoted] + [shlex.quote(a) for a in hook.args] + ["--client", tool]
    return " ".join(parts)


def hook_kind(hook: Hook) -> str | None:
    if "mcp" in hook.match:
        return "mcp"
    if hook.match.get("shell"):
        return "shell"
    if "tool" in hook.match:
        return "tool"
    return None


def hook_event_name(hook: Hook, tool: str) -> str | None:
    kind = hook_kind(hook)
    if tool == "cursor" and kind in ("mcp", "shell"):
        special = CURSOR_SPECIAL.get((hook.event, kind))
        if special:
            return special
    return EVENT_MAP[tool].get(hook.event)


def hook_matcher(hook: Hook, tool: str) -> str | None:
    if hook.event not in ("before_tool", "after_tool"):
        return None
    kind = hook_kind(hook)
    if kind == "mcp":
        pattern = str(hook.match["mcp"])
        if tool == "claude":
            return "mcp__" + pattern
        if tool == "cursor":
            return None  # dedicated MCP event; the script filters by server
        return pattern
    if kind == "shell":
        return {"claude": "Bash", "gemini": "run_shell_command"}.get(tool)
    if kind == "tool":
        names = []
        for n in str(hook.match["tool"]).split("|"):
            mapped = TOOL_NAME_MAP[tool].get(n.strip(), n.strip())
            if mapped and mapped not in names:
                names.append(mapped)
        return "|".join(names)
    return None


def render_hooks(root: Path, state: State, tool: str) -> dict[str, list[Any]]:
    out: dict[str, list[Any]] = {}
    for h in state.enabled_hooks():
        if h.tools is not None and tool not in h.tools:
            continue
        if h.event not in EVENTS:
            continue
        event = hook_event_name(h, tool)
        if event is None:
            continue
        cmd = hook_command(root, state.bundles, h, tool)
        matcher = hook_matcher(h, tool)
        if tool == "cursor":
            entry: dict[str, Any] = {"command": cmd, "timeout": h.timeout_s}
            if matcher:
                entry["matcher"] = matcher
            if h.fail_closed:
                entry["failClosed"] = True
        elif tool == "gemini":
            handler: dict[str, Any] = {"type": "command", "command": cmd, "name": h.id,
                                       "timeout": h.timeout_s * 1000}
            if h.description:
                handler["description"] = h.description
            entry = {"matcher": matcher, "hooks": [handler]} if matcher else {"hooks": [handler]}
        else:  # claude, antigravity
            handler = {"type": "command", "command": cmd, "timeout": h.timeout_s}
            entry = {"matcher": matcher, "hooks": [handler]} if matcher else {"hooks": [handler]}
        out.setdefault(event, []).append(entry)
    return out


_VAR_RE = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)(?::-[^}]*)?\}")


def _mcp_value(root: Path, tool: str, value: Any) -> Any:
    if isinstance(value, list):
        return [_mcp_value(root, tool, v) for v in value]
    if isinstance(value, dict):
        return {k: _mcp_value(root, tool, v) for k, v in value.items()}
    if not isinstance(value, str):
        return value
    s = value.replace("${SKELETON_ROOT}", str(root))
    if tool == "cursor":
        s = _VAR_RE.sub(lambda m: "${env:" + m.group(1) + "}", s)
    return s


def render_mcp(root: Path, state: State, tool: str) -> dict[str, Any]:
    servers: dict[str, Any] = {}
    for m in state.enabled_mcp():
        spec = m.spec
        tools = spec.get("tools")
        if isinstance(tools, list) and tool not in tools:
            continue
        v = lambda x: _mcp_value(root, tool, x)  # noqa: E731
        entry: dict[str, Any] = {}
        if spec.get("command"):
            command = os.path.expanduser(str(spec["command"])) if str(spec["command"]).startswith("~/") \
                else str(spec["command"])
            if tool == "claude":
                entry["type"] = "stdio"
            entry["command"] = v(command)
            if spec.get("args"):
                entry["args"] = v(list(spec["args"]))
            if spec.get("env"):
                entry["env"] = v(dict(spec["env"]))
            if spec.get("cwd"):
                entry["cwd"] = v(str(spec["cwd"]))
        elif spec.get("url"):
            kind = str(spec.get("type", "http"))
            url = v(str(spec["url"]))
            if tool == "claude":
                entry["type"] = kind
                entry["url"] = url
            elif tool == "cursor":
                entry["url"] = url
            elif tool == "gemini":
                entry["url" if kind == "sse" else "httpUrl"] = url
            else:
                entry["serverUrl"] = url
            if spec.get("headers"):
                entry["headers"] = v(dict(spec["headers"]))
        else:
            continue
        servers[m.name] = entry
    return servers


def render_rendered_skill(root: Path, plan: Plan, rs: ResolvedSkill) -> str:
    """Write a patched SKILL.md copy plus links to the other entries."""
    base = f"{RENDERED_SKILLS}/{rs.skill.name}"
    text = (rs.source / "SKILL.md").read_text(encoding="utf-8")
    remove = {"disable-model-invocation", "user-invocable"}
    set_keys: dict[str, Any] = {}
    if rs.invocation == "user":
        set_keys["disable-model-invocation"] = True
    elif rs.invocation == "model":
        set_keys["user-invocable"] = False
    plan.file(f"{base}/SKILL.md", patch_frontmatter(text, set_keys, remove))
    for entry in sorted(rs.source.iterdir()):
        if entry.name == "SKILL.md":
            continue
        rel = f"{base}/{entry.name}"
        plan.link(rel, link_target(root, rel, entry))
    return base


def gemini_command_toml(rs: ResolvedSkill) -> str:
    name = rs.skill.name
    desc = str(rs.meta.get("description", "") or name)
    prompt = (f"Activate the agent skill `{name}` (file: .agents/skills/{name}/SKILL.md) "
              "and follow its instructions.\n\nArguments: {{args}}\n")
    return (f"# {MARKER}. Source: skill {name}\n"
            f"description = {json.dumps(desc, ensure_ascii=False)}\n"
            f'prompt = """\n{prompt}"""\n')


def load_template(root: Path, tool: str) -> dict[str, Any]:
    path = root / "kit" / "tool-config" / tool / "settings.json"
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        fail(f"{_rel(root, path)}: invalid JSON: {exc}")
    return data if isinstance(data, dict) else {}


def build_plan(state: State) -> Plan:
    root = state.root
    plan = Plan()
    tools = state.tools
    skills = sorted(state.enabled_skills(), key=lambda s: s.skill.name)
    rules = state.enabled_rules()
    settings_extra = _cfg_table(state.config, "settings")
    known = {s.skill.name for s in state.skills}
    disabled_skills = sorted(known - {s.skill.name for s in skills})

    # Skills: a rendered copy when an invocation override applies, else a link.
    link_sources: dict[str, Path] = {}
    if tools:
        for rs in skills:
            if rs.needs_render:
                link_sources[rs.skill.name] = root / render_rendered_skill(root, plan, rs)
            else:
                link_sources[rs.skill.name] = rs.source
    skill_dirs = []
    if "claude" in tools:
        skill_dirs.append(".claude/skills")
    if any(t in tools for t in AGENTS_SKILL_TOOLS):
        skill_dirs.append(".agents/skills")
    for d in skill_dirs:
        for name, src in link_sources.items():
            rel = f"{d}/{name}"
            plan.link(rel, link_target(root, rel, src))

    if "claude" in tools:
        plan.file("CLAUDE.md", "@AGENTS.md\n\n"
                  f"<!-- {MARKER}. Shared instructions live in AGENTS.md; edit that file instead. -->\n")
        for r in rules:
            content = render_rule_claude(root, r)
            if content is not None:
                plan.file(f".claude/rules/{r.name}.md", content)
        settings = apply_permission_adds(
            deep_merge(load_template(root, "claude"), _cfg_table(settings_extra, "claude")))
        merge_hooks(settings, render_hooks(root, state, "claude"))
        if disabled_skills:
            so = settings.get("skillOverrides", {}) if isinstance(settings.get("skillOverrides"), dict) else {}
            for n in disabled_skills:
                so.setdefault(n, "off")
            settings["skillOverrides"] = so
        plan.file(".claude/settings.json", dump_json(settings))
        servers = render_mcp(root, state, "claude")
        if servers:
            plan.file(".mcp.json", dump_json({"mcpServers": servers}))

    if "cursor" in tools:
        for r in rules:
            plan.file(f".cursor/rules/{r.name}.mdc", render_rule_cursor(root, r))
        hooks = render_hooks(root, state, "cursor")
        if hooks:
            plan.file(".cursor/hooks.json", dump_json({"version": 1, "hooks": hooks}))
        servers = render_mcp(root, state, "cursor")
        if servers:
            plan.file(".cursor/mcp.json", dump_json({"mcpServers": servers}))

    if "gemini" in tools:
        settings = deep_merge(load_template(root, "gemini"), _cfg_table(settings_extra, "gemini"))
        merge_hooks(settings, render_hooks(root, state, "gemini"))
        servers = render_mcp(root, state, "gemini")
        if servers:
            settings["mcpServers"] = servers
        if disabled_skills:
            sk = settings.get("skills", {}) if isinstance(settings.get("skills"), dict) else {}
            sk["disabled"] = sorted(set(sk.get("disabled", [])) | set(disabled_skills))
            settings["skills"] = sk
        plan.file(".gemini/settings.json", dump_json(settings))
        rules_md = render_gemini_rules(root, rules)
        if rules_md:
            plan.file(".gemini/RULES.md", rules_md)
        for rs in skills:
            if rs.user_only:
                plan.file(f".gemini/commands/{rs.skill.name}.toml", gemini_command_toml(rs))

    if "antigravity" in tools:
        for r in rules:
            plan.file(f".agents/rules/{r.name}.md", render_rule_antigravity(root, r))
        hooks = render_hooks(root, state, "antigravity")
        if hooks:
            plan.file(".agents/hooks.json", dump_json({"hooks": hooks}))
        servers = render_mcp(root, state, "antigravity")
        if servers:
            plan.file(".agents/mcp_config.json", dump_json({"mcpServers": servers}))
    return plan


# --------------------------------------------------------------------------- #
# Applying a plan (idempotent, prunes stale generated entries)
# --------------------------------------------------------------------------- #

@dataclass
class ApplyReport:
    changed: list[str] = field(default_factory=list)
    pruned: list[str] = field(default_factory=list)
    skipped: list[str] = field(default_factory=list)


def read_manifest(root: Path) -> set[str]:
    path = root / MANIFEST
    if not path.exists():
        return set()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return set(data.get("paths", []))
    except (OSError, json.JSONDecodeError):
        return set()


def _points_into_kit(root: Path, p: Path) -> bool:
    if not p.is_symlink():
        return False
    target = Path(os.path.abspath(os.path.join(p.parent, os.readlink(p))))
    if not target.exists():
        return True  # broken link inside a generated dir
    for base in ("kit", "local", ".skeleton"):
        try:
            target.relative_to(root / base)
            return True
        except ValueError:
            pass
    return False


def _is_ours_file(p: Path) -> bool:
    try:
        return MARKER in p.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return False


def _remove(p: Path) -> None:
    if p.is_symlink() or p.is_file():
        p.unlink()
    elif p.is_dir():
        shutil.rmtree(p)


def _write_file(p: Path, content: str) -> None:
    p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(f".{p.name}.skeleton-tmp")
    tmp.write_text(content, encoding="utf-8")
    os.replace(tmp, p)


def diff_plan(root: Path, plan: Plan) -> list[str]:
    """Return human-readable differences between the plan and the disk."""
    out = []
    for rel, (kind, payload) in sorted(plan.entries.items()):
        p = root / rel
        if kind == "link":
            if not p.is_symlink():
                out.append(f"missing link {rel}")
            elif os.readlink(p) != payload:
                out.append(f"stale link {rel}")
        else:
            if p.is_symlink() or not p.is_file():
                out.append(f"missing file {rel}")
            elif p.read_text(encoding="utf-8") != payload:
                out.append(f"stale file {rel}")
    for rel in sorted(read_manifest(root) - set(plan.entries)):
        if (root / rel).is_symlink() or (root / rel).exists():
            out.append(f"stale entry to prune {rel}")
    return out


def apply_plan(root: Path, plan: Plan, force: bool = False) -> ApplyReport:
    report = ApplyReport()
    old = read_manifest(root)
    written: set[str] = set()
    for rel, (kind, payload) in sorted(plan.entries.items()):
        p = root / rel
        ours = rel in old
        if kind == "link":
            if p.is_symlink():
                if os.readlink(p) == payload:
                    written.add(rel)
                    continue
                if not (ours or force or _points_into_kit(root, p)):
                    report.skipped.append(f"{rel} (a symlink not created by skeleton)")
                    continue
                p.unlink()
            elif p.exists():
                if not (force or (p.is_file() and _is_ours_file(p))):
                    report.skipped.append(f"{rel} (exists and was not created by skeleton)")
                    continue
                _remove(p)
            p.parent.mkdir(parents=True, exist_ok=True)
            os.symlink(payload, p)
        else:
            if p.is_symlink():
                if not (ours or force or _points_into_kit(root, p)):
                    report.skipped.append(f"{rel} (a symlink not created by skeleton)")
                    continue
                p.unlink()
            elif p.is_dir():
                report.skipped.append(f"{rel} (is a directory)")
                continue
            elif p.exists():
                current = p.read_text(encoding="utf-8", errors="replace")
                if current == payload:
                    written.add(rel)
                    continue
                if not (ours or force or MARKER in current):
                    report.skipped.append(f"{rel} (exists and was not created by skeleton; use --force)")
                    continue
            _write_file(p, payload)
        written.add(rel)
        report.changed.append(rel)

    # Prune entries generated last time and not wanted now.
    for rel in sorted(old - set(plan.entries)):
        p = root / rel
        if p.is_symlink() or p.exists():
            _remove(p)
            report.pruned.append(rel)
    # Sweep owned dirs for leftovers (for example after the manifest was lost).
    wanted_dirs = {rel.split("/")[2] for rel in plan.entries if rel.startswith(RENDERED_SKILLS + "/")}
    for d in OWNED_DIRS:
        base = root / d
        if not base.is_dir() or base.is_symlink():
            continue
        for entry in sorted(base.iterdir()):
            rel = _rel(root, entry)
            if rel in plan.entries:
                continue
            if d == RENDERED_SKILLS:
                if entry.name not in wanted_dirs:
                    _remove(entry)
                    report.pruned.append(rel)
            elif _points_into_kit(root, entry) or (entry.is_file() and not entry.is_symlink()
                                                   and _is_ours_file(entry)):
                _remove(entry)
                report.pruned.append(rel)
    for d in sorted(PRUNE_EMPTY_DIRS, key=lambda x: -x.count("/")):
        base = root / d
        if base.is_dir() and not base.is_symlink() and not any(base.iterdir()):
            base.rmdir()

    manifest = {"version": 1, "note": MARKER, "paths": sorted(written)}
    content = dump_json(manifest)
    mpath = root / MANIFEST
    if not mpath.exists() or mpath.read_text(encoding="utf-8") != content:
        _write_file(mpath, content)
    return report


# --------------------------------------------------------------------------- #
# Commands
# --------------------------------------------------------------------------- #

def _parse_tools(value: str | None) -> list[str] | None:
    if value is None:
        return None
    return [t.strip() for t in value.split(",") if t.strip()]


def run_init(root: Path, tools: list[str] | None = None, force: bool = False,
             verbose: bool = False, quiet: bool = False) -> int:
    state = resolve_state(root, tools)
    for w in state.warnings:
        warn(w)
    plan = build_plan(state)
    report = apply_plan(root, plan, force=force)
    for s in report.skipped:
        warn(f"skipped {s}")
    if verbose:
        for rel in report.changed:
            info(STYLE.green(f"  + {rel}"))
        for rel in report.pruned:
            info(STYLE.dim(f"  - {rel}"))
    if not quiet:
        n_sk = len(state.enabled_skills())
        n_ru = len(state.enabled_rules())
        n_ho = len(state.enabled_hooks())
        n_mc = len(state.enabled_mcp())
        info(f"✅ **init** {n_sk} skills, {n_ru} rules, {n_ho} hooks, {n_mc} MCP servers for "
             f"{', '.join(state.tools) or 'no tools'} ({len(report.changed)} written, "
             f"{len(report.pruned)} pruned, {len(report.skipped)} skipped)")
    return 1 if report.skipped else 0


def cmd_init(ctx: argparse.Namespace) -> int:
    root = ctx.root
    tools = _parse_tools(ctx.tools)
    if ctx.check:
        state = resolve_state(root, tools)
        diffs = diff_plan(root, build_plan(state))
        if diffs:
            for d in diffs:
                info(f"  {d}")
            info(f"⚠️ **generated tree** is stale ({len(diffs)} differences): run bin/skeleton init")
            return 1
        info("✅ **generated tree** is up to date")
        return 0
    return run_init(root, tools, force=ctx.force, verbose=ctx.verbose)


def _state_label(on: bool) -> str:
    return STYLE.green("on ") if on else STYLE.dim("off")


def _pad(text: str, width: int) -> str:
    visible = len(re.sub(r"\033\[[0-9;]*m", "", text))
    return text + " " * max(0, width - visible)


def cmd_list(ctx: argparse.Namespace) -> int:
    state = resolve_state(ctx.root)
    if ctx.names:
        for name, b in state.bundles.items():
            if not ctx.enabled or state.bundle_on[name]:
                print(name)
        return 0
    show_bundles = not ctx.skills
    show_skills = not ctx.bundles
    if show_bundles:
        info(STYLE.bold(f"🦴 agent-skeleton bundles") + STYLE.dim(f"  (tools: {', '.join(state.tools)})"))
        info("")
        w = max([len(n) for n in state.bundles] + [6]) + 2
        any_local = any(b.local for b in state.bundles.values())
        sw = 11 if any_local else 7
        info(STYLE.dim("    " + _pad("BUNDLE", w) + _pad("STATE", sw)
                       + "SKILLS  RULES  HOOKS  MCP  DESCRIPTION"))
        for name, b in state.bundles.items():
            on = state.bundle_on[name]
            tag = _state_label(on) + (STYLE.cyan(" local") if b.local else "")
            desc = b.description
            if len(desc) > 60:
                desc = desc[:57] + "..."
            row = (f"{b.emoji}  " + _pad(STYLE.bold(name) if on else name, w) + _pad(tag, sw)
                   + _pad(str(len(b.skills)), 8) + _pad(str(len(b.rules)), 7)
                   + _pad(str(len(b.hooks)), 7) + _pad(str(len(b.mcp)), 5) + STYLE.dim(desc))
            info(row)
        info("")
    if show_skills:
        info(STYLE.bold("🧩 skills"))
        info("")
        rows = sorted(state.skills, key=lambda r: (r.skill.bundle, r.skill.name))
        if not rows:
            info(STYLE.dim("    (no skills)"))
        w = max([len(r.skill.name) for r in rows] + [5]) + 2
        wb = max([len(r.skill.bundle) for r in rows] + [6]) + 2
        info(STYLE.dim("    " + _pad("BUNDLE", wb) + _pad("SKILL", w) + "STATE  NOTES"))
        for r in rows:
            notes = []
            if r.overridden:
                notes.append(STYLE.yellow("overridden"))
            if r.user_only:
                notes.append("user-invocable only")
            if r.invocation == "model":
                notes.append("model-only")
            if r.skill.error:
                notes.append(STYLE.red("error: " + r.skill.error))
            if state.bundles[r.skill.bundle].local:
                notes.append(STYLE.cyan("local"))
            emoji = state.bundles[r.skill.bundle].emoji
            info(f"{emoji}  " + _pad(r.skill.bundle, wb) + _pad(r.skill.name, w)
                 + _pad(_state_label(r.enabled), 7) + ", ".join(notes))
        info("")
        info(STYLE.dim("Toggle with: bin/skeleton enable|disable <bundle|skill|rule|hook>"))
    for w_ in state.warnings:
        warn(w_)
    return 0


def find_target(state: State, target: str, kind: str | None) -> tuple[str, str]:
    kinds = [kind] if kind else list(KINDS)
    for k in kinds:
        if k == "bundle" and target in state.bundles:
            return "bundle", target
        if k == "skill" and any(s.skill.name == target for s in state.skills):
            return "skill", target
        if k == "rule" and any(r.name == target for r, _ in state.rules):
            return "rule", target
        if k == "hook" and any(h.id == target for h, _ in state.hooks):
            return "hook", target
    fail(f"**{target}** is not a known {kind or 'bundle, skill, rule or hook'}. "
         "Run bin/skeleton list to see the names.")
    return "", ""


def _default_value(state: State, kind: str, name: str) -> bool:
    """The value a key has when skeleton.local.toml does not mention it."""
    if kind == "bundle":
        base = load_toml_file(state.root / "skeleton.toml") if (state.root / "skeleton.toml").exists() else {}
        v = _cfg_table(base, "bundles").get(name)
        if isinstance(v, bool):
            return v
        return bundle_default(state.config, state.bundles[name])
    owner = None
    if kind == "skill":
        owner = next(s.skill.bundle for s in state.skills if s.skill.name == name)
    elif kind == "rule":
        owner = next(r.bundle for r, _ in state.rules if r.name == name)
    elif kind == "hook":
        owner = next(h.bundle for h, _ in state.hooks if h.id == name)
    return state.bundle_on.get(owner, True) if owner else True


def cmd_toggle(ctx: argparse.Namespace, on: bool) -> int:
    root = ctx.root
    state = resolve_state(root)
    kind, name = find_target(state, ctx.target, ctx.kind)
    local_path = root / "skeleton.local.toml"
    text = local_path.read_text(encoding="utf-8") if local_path.exists() else (
        "# Personal overrides for agent-skeleton (git-ignored).\n"
        "# See skeleton.local.example.toml for every supported key.\n")
    current = tomllib.loads(text)
    table = {"bundle": "bundles", "skill": "skills", "rule": "rules", "hook": "hooks"}[kind]
    existing = _cfg_table(current, table).get(name)
    default = _default_value(state, kind, name)
    if isinstance(existing, dict):
        new = dict(existing)
        if on == default:
            new.pop("enabled", None)
        else:
            new["enabled"] = on
        text = toml_set_key(text, table, name, new) if new else toml_remove_key(text, table, name)
    elif on == default:
        text = toml_remove_key(text, table, name)
    else:
        text = toml_set_key(text, table, name, on)
    try:
        tomllib.loads(text)
    except tomllib.TOMLDecodeError as exc:
        fail(f"refusing to write an invalid skeleton.local.toml: {exc}")
    if not local_path.exists() or local_path.read_text(encoding="utf-8") != text:
        local_path.write_text(text, encoding="utf-8")
    verb = "enabled" if on else "disabled"
    if kind == "skill" and on:
        sk = next(s for s in state.skills if s.skill.name == name)
        if not state.bundle_on.get(sk.skill.bundle, False):
            warn(f"skill '{name}' is on although its bundle '{sk.skill.bundle}' is off")
    rc = 0
    if not ctx.no_init:
        rc = run_init(root, quiet=True)
    info(f"✅ **{name}** ({kind}) {verb}" + ("" if ctx.no_init else ", workspace re-rendered"))
    return rc


def cmd_setup(ctx: argparse.Namespace) -> int:
    state = resolve_state(ctx.root)
    b = state.bundles.get(ctx.bundle)
    if b is None:
        fail(f"**{ctx.bundle}** is not a bundle. Available: {', '.join(state.bundles)}")
    script = b.path / "setup.sh"
    if not script.exists():
        info(f"⚠️ **{b.name}** has no setup.sh; nothing to configure")
        return 0
    return subprocess.call(["/bin/bash", str(script)] + list(ctx.args), cwd=str(ctx.root))


# ----- doctor ---------------------------------------------------------------- #

def _file_mode_ok(p: Path) -> tuple[bool, str]:
    mode = p.stat().st_mode & 0o777
    return (mode & 0o077) == 0, oct(mode)


def cmd_doctor(ctx: argparse.Namespace) -> int:
    root = ctx.root
    errors = 0
    ok = lambda m: info(STYLE.green("✅ ") + m)  # noqa: E731
    note = lambda m: info(STYLE.cyan("ℹ️  ") + m)  # noqa: E731
    attn = lambda m: info(STYLE.yellow("⚠️  ") + m)  # noqa: E731

    v = sys.version_info
    if v >= MIN_PYTHON:
        ok(f"python {v.major}.{v.minor}.{v.micro} ({sys.executable})")
    else:
        info(STYLE.red("❌ ") + f"python {v.major}.{v.minor} is too old (need >= 3.11)")
        errors += 1
    if not (root / "skeleton.toml").exists():
        info(STYLE.red("❌ ") + "skeleton.toml is missing")
        return 1
    state = resolve_state(root)
    for w in state.warnings:
        attn(w)
    ok(f"tools: {', '.join(state.tools)}")
    for name, b in state.bundles.items():
        if b.errors:
            info(STYLE.red("❌ ") + f"bundle {name}: {'; '.join(b.errors)}")
            errors += 1
    for name, b in state.bundles.items():
        if not state.bundle_on[name]:
            continue
        missing = [c for c in b.meta.get("commands", []) or [] if not shutil.which(c)]
        optional = [c for c in b.meta.get("optional_commands", []) or [] if not shutil.which(c)]
        if missing:
            brew = ", ".join(b.meta.get("brew", []) or []) or "see the bundle docs"
            attn(f"{b.emoji} {name}: missing {', '.join(missing)} (Homebrew: {brew})")
        elif b.meta.get("commands"):
            ok(f"{b.emoji} {name}: {', '.join(b.meta['commands'])} found")
        if optional:
            note(f"{b.emoji} {name}: optional, not found: {', '.join(optional)}")
        for cf in b.meta.get("config_files", []) or []:
            p = Path(os.path.expanduser(str(cf)))
            if not p.exists():
                attn(f"{b.emoji} {name}: config {cf} not found (run bin/skeleton setup {name})")
                continue
            good, mode = _file_mode_ok(p)
            if good:
                ok(f"{b.emoji} {name}: config {cf} ({mode})")
            else:
                attn(f"{b.emoji} {name}: config {cf} is {mode}; run chmod 600 {cf}")
    diffs = diff_plan(root, build_plan(state))
    if diffs:
        attn(f"generated tree is stale ({len(diffs)} differences): run bin/skeleton init")
    else:
        ok("generated tree is up to date")
    found = {t: shutil.which(t) for t in ("claude", "cursor", "agent", "gemini", "agy")}
    have = [t for t, p in found.items() if p]
    note("tool CLIs on PATH: " + (", ".join(have) if have else "none found (IDE apps may still work)"))
    if "cursor" in state.tools:
        note("Cursor: turn OFF Settings > Rules > 'Include third-party plugins, skills and other configs'. "
             "Otherwise Cursor also loads .claude/ and every skill and Claude hook runs twice.")
    if "gemini" in state.tools:
        note("Gemini CLI serves Code Assist Standard/Enterprise and paid API keys; other Google accounts "
             "use Antigravity CLI (agy), which reads AGENTS.md and .agents/.")
    if errors:
        info(STYLE.red(f"❌ **doctor** found {errors} error(s)"))
        return 1
    info("✅ **doctor** finished")
    return 0


# ----- projects -------------------------------------------------------------- #

def _norm(s: str) -> str:
    return s.lower().replace("-", "").replace("_", "").replace(" ", "")


def _bigrams(s: str) -> set[str]:
    return {s[i:i + 2] for i in range(len(s) - 1)}


def fuzzy_match(user_input: str, candidates: list[str]) -> tuple[str | None, list[str]]:
    """Return (match, ambiguous). Exact, then substring, then bigram similarity."""
    inp = _norm(user_input)
    exact = [c for c in candidates if _norm(c) == inp]
    if exact:
        return exact[0], []
    sub = [c for c in candidates if inp and (inp in _norm(c) or _norm(c) in inp)]
    if len(sub) == 1:
        return sub[0], []
    if len(sub) > 1:
        return None, sub
    ba = _bigrams(inp)
    scored = []
    for c in candidates:
        bb = _bigrams(_norm(c))
        score = len(ba & bb) / len(ba | bb) if ba and bb else 0.0
        scored.append((c, score))
    scored.sort(key=lambda x: -x[1])
    top = [(c, s) for c, s in scored if s >= 0.4]
    if not top:
        return None, []
    if len(top) == 1 or top[0][1] - top[1][1] > 0.15:
        return top[0][0], []
    return None, [c for c, _ in top[:5]]


def _projects_dir(state: State) -> Path:
    raw = str(_cfg_table(state.config, "paths").get("projects_dir", DEFAULT_PROJECTS_DIR))
    return Path(os.path.expanduser(raw))


def _linked_projects(root: Path) -> list[str]:
    d = root / "projects"
    if not d.is_dir():
        return []
    return sorted(e.name for e in d.iterdir() if e.is_symlink())


def regenerate_workspace(root: Path) -> Path:
    path = root / WORKSPACE_FILE
    data: dict[str, Any] = {}
    if path.exists():
        try:
            loaded = json.loads(path.read_text(encoding="utf-8"))
            data = loaded if isinstance(loaded, dict) else {}
        except json.JSONDecodeError:
            data = {}
    data["folders"] = [{"name": WORKSPACE_ROOT_NAME, "path": "."}] + [
        {"name": n, "path": f"projects/{n}"} for n in _linked_projects(root)]
    data.setdefault("settings", {})
    content = dump_json(data)
    if not path.exists() or path.read_text(encoding="utf-8") != content:
        path.write_text(content, encoding="utf-8")
    return path


def cmd_projects(ctx: argparse.Namespace) -> int:
    root = ctx.root
    state = resolve_state(root)
    pdir = _projects_dir(state)
    links = root / "projects"
    if ctx.action == "list":
        linked = _linked_projects(root)
        if linked:
            info(f"📂 **{len(linked)}** linked project(s):")
            for n in linked:
                info(f"  • **{n}** -> {os.readlink(links / n)}")
        else:
            info("📭 No projects are linked yet.")
        if pdir.is_dir():
            avail = sorted(e.name for e in pdir.iterdir() if e.is_dir() and not e.name.startswith(".")
                           and e.resolve() != root and e.name not in linked)
            info(f"🔗 **{len(avail)}** available under {pdir}:")
            for n in avail:
                info(f"  - {n}")
        else:
            info(f"⚠️ projects_dir {pdir} does not exist (set [paths] projects_dir in skeleton.local.toml)")
        return 0
    if ctx.action == "sync":
        # Rebuild the code-workspace from the links already in projects/, linking nothing.
        dangling = [n for n in _linked_projects(root) if not (links / n).exists()]
        for n in dangling:
            info(f"⚠️ **{n}** points to a missing directory: {os.readlink(links / n)}")
        path = regenerate_workspace(root)
        info(f"🗂️  {path.name} updated ({len(_linked_projects(root))} project(s))")
        return 0
    if not ctx.names:
        fail("give at least one project name")
    rc = 0
    for raw in ctx.names:
        if ctx.action == "add":
            rc = max(rc, _project_add(root, pdir, raw))
        else:
            rc = max(rc, _project_remove(root, raw))
    path = regenerate_workspace(root)
    info(STYLE.dim(f"🗂️  {path.name} updated ({len(_linked_projects(root))} project(s))"))
    return rc


def _project_add(root: Path, pdir: Path, raw: str) -> int:
    links = root / "projects"
    as_path = Path(os.path.expanduser(raw))
    if ("/" in raw or raw.startswith((".", "~"))) and as_path.is_dir():
        target, name = as_path.resolve(), as_path.resolve().name
    else:
        if not pdir.is_dir():
            info(f"❌ **{raw}**: projects_dir {pdir} does not exist")
            return 1
        avail = sorted(e.name for e in pdir.iterdir() if e.is_dir() and not e.name.startswith(".")
                       and e.resolve() != root)
        match, cands = fuzzy_match(raw, avail)
        if not match and cands:
            info(f"❓ **{raw}** is ambiguous: {', '.join(cands)}")
            return 2
        if not match:
            info(f"❌ **{raw}** not found under {pdir}")
            return 1
        target, name = pdir / match, match
    link = links / name
    if link.is_symlink() or link.exists():
        info(f"⚠️ **{name}** is already linked")
        return 0
    links.mkdir(exist_ok=True)
    os.symlink(str(target), link)
    info(f"✅ **{name}** linked -> {target}")
    return 0


def _project_remove(root: Path, raw: str) -> int:
    linked = _linked_projects(root)
    match, cands = fuzzy_match(raw, linked)
    if not match and cands:
        info(f"❓ **{raw}** is ambiguous: {', '.join(cands)}")
        return 2
    if not match:
        info(f"❌ **{raw}** is not linked. Linked: {', '.join(linked) or 'none'}")
        return 1
    (root / "projects" / match).unlink()
    info(f"🗑️ **{match}** unlinked (the repository itself is untouched)")
    return 0


# ----- new-skill ------------------------------------------------------------- #

SKILL_TEMPLATE = """---
name: {name}
description: {description}
{extra}---

# {title}

One or two sentences: what this skill achieves and why it exists.

## When to use

- Trigger phrase or situation 1
- Trigger phrase or situation 2

## Steps

1. First step, with the exact command when there is one:
   `kit/bundles/{bundle}/scripts/<script>.sh <args>`
2. Second step.
3. How to verify the result.

## Gotchas

- Things that went wrong before, and how to avoid them.

## References

- Put long material in `references/<topic>.md` and link it from here.
"""


def cmd_new_skill(ctx: argparse.Namespace) -> int:
    root = ctx.root
    name = ctx.name
    if not NAME_RE.match(name) or len(name) > MAX_NAME:
        fail(f"**{name}**: skill names are kebab-case [a-z0-9-], at most {MAX_NAME} characters")
    base = None
    for cand in (root / "kit" / "bundles" / ctx.bundle, root / "local" / "bundles" / ctx.bundle):
        if (cand / "bundle.toml").exists():
            base = cand
    if base is None:
        fail(f"**{ctx.bundle}** is not a bundle (create kit/bundles/{ctx.bundle}/bundle.toml first)")
    target = base / "skills" / name
    if target.exists():
        fail(f"**{name}** already exists at {_rel(root, target)}")
    desc = ctx.description or ("TODO: what this skill does and when to use it, with trigger phrases. "
                               "Keep it under 300 characters.")
    extra = "disable-model-invocation: true\n" if ctx.user_invocable else ""
    title = " ".join(w.capitalize() for w in name.split("-"))
    content = SKILL_TEMPLATE.format(name=name, description=yaml_scalar(desc), extra=extra,
                                    title=title, bundle=ctx.bundle)
    target.mkdir(parents=True)
    (target / "SKILL.md").write_text(content, encoding="utf-8")
    info(f"✅ **{name}** created at {_rel(root, target / 'SKILL.md')} (run bin/skeleton init to expose it)")
    return 0


# ----- check ----------------------------------------------------------------- #

def _load_denylist(root: Path) -> list[re.Pattern[str]]:
    path = root / "tests" / "denylist.txt"
    pats = []
    if path.exists():
        for line in path.read_text(encoding="utf-8").splitlines():
            if line.strip() and not line.lstrip().startswith("#"):
                pats.append(re.compile(line.strip()))
    return pats


def _iter_scan_files(root: Path):
    for dirpath, dirnames, filenames in os.walk(root):
        rel_dir = Path(dirpath).relative_to(root)
        dirnames[:] = sorted(d for d in dirnames if not (rel_dir == Path(".") and d in SCAN_SKIP_DIRS)
                             and d not in ("__pycache__", ".git"))
        for fn in sorted(filenames):
            if rel_dir == Path(".") and fn in SCAN_SKIP_FILES:
                continue
            if fn.endswith(".code-workspace") or fn in (".DS_Store", ".git"):
                continue
            p = Path(dirpath) / fn
            if p.is_symlink():
                continue
            yield p


LOCAL_SCAN_DIRS = ("skills", "rules", "scripts")


def _iter_local_scan_files(root: Path):
    """Agent-facing files of private bundles: local/bundles/*/{skills,rules,scripts}."""
    base = root / "local" / "bundles"
    if not base.is_dir():
        return
    for b in sorted(base.iterdir()):
        if not b.is_dir() or b.is_symlink() or b.name.startswith((".", "_")):
            continue
        for sub in LOCAL_SCAN_DIRS:
            top = b / sub
            if not top.is_dir() or top.is_symlink():
                continue
            for dirpath, dirnames, filenames in os.walk(top):
                dirnames[:] = sorted(d for d in dirnames if d not in ("__pycache__", ".git", "node_modules"))
                for fn in sorted(filenames):
                    p = Path(dirpath) / fn
                    if fn == ".DS_Store" or p.is_symlink():
                        continue
                    yield p


def _em_dash_error(root: Path, p: Path, text: str) -> str | None:
    if EM_DASH not in text:
        return None
    line = text[:text.index(EM_DASH)].count("\n") + 1
    return f"{_rel(root, p)}:{line}: contains U+2014 (em dash); use a comma, colon, parentheses or '-'"


def _unquoted_colon(block: str, key: str) -> bool:
    for line in block.split("\n"):
        m = _KEY_RE.match(line)
        if m and m.group(1) == key:
            val = (m.group(2) or "").strip()
            return bool(val) and val[0] not in "\"'|>" and ": " in val
    return False


_SCRIPT_REF = re.compile(r"(?:kit|local)/bundles/[a-z0-9-]+/(?:scripts|skills)/[A-Za-z0-9_./-]+")


def run_checks(root: Path) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []
    w: list[str] = []
    bundles = discover_bundles(root, w)
    warnings += w
    brewfile = root / "Brewfile"
    brew_names = set()
    if brewfile.exists():
        for line in brewfile.read_text(encoding="utf-8").splitlines():
            m = re.match(r'^\s*#?\s*(?:brew|cask)\s+"([^"]+)"', line)
            if m:
                brew_names.add(m.group(1))
    skill_owner: dict[str, str] = {}
    rule_owner: dict[str, str] = {"skeleton-user-profile": "the generated [user] profile"}
    hook_ids: dict[str, str] = {}
    for name, b in bundles.items():
        where = f"{_rel(root, b.path)}"
        errors += [f"{where}: {e}" for e in b.errors]
        meta = b.meta
        if meta:
            if meta.get("name") != name:
                errors.append(f"{where}/bundle.toml: name '{meta.get('name')}' must equal the folder '{name}'")
            for key in ("title", "description", "emoji"):
                if not meta.get(key):
                    errors.append(f"{where}/bundle.toml: missing '{key}'")
            if "default_enabled" in meta and not isinstance(meta["default_enabled"], bool):
                errors.append(f"{where}/bundle.toml: default_enabled must be true or false")
            for key in ("requires", "brew", "commands", "optional_commands", "config_files"):
                if key in meta and not (isinstance(meta[key], list) and all(isinstance(x, str) for x in meta[key])):
                    errors.append(f"{where}/bundle.toml: '{key}' must be a list of strings")
            for req in meta.get("requires", []) or []:
                if req not in bundles:
                    errors.append(f"{where}/bundle.toml: requires unknown bundle '{req}'")
            if not b.local:
                for formula in meta.get("brew", []) or []:
                    if brew_names and formula not in brew_names:
                        warnings.append(f"{where}/bundle.toml: brew '{formula}' is not listed in the Brewfile")
        for sk in b.skills:
            sw = f"{_rel(root, sk.path)}/SKILL.md"
            if sk.error:
                errors.append(f"{sw}: {sk.error}")
                continue
            text = (sk.path / "SKILL.md").read_text(encoding="utf-8")
            block, _ = split_frontmatter(text)
            fm_name = sk.meta.get("name")
            if fm_name != sk.name:
                errors.append(f"{sw}: name '{fm_name}' must equal the folder name '{sk.name}'")
            if not NAME_RE.match(sk.name) or len(sk.name) > MAX_NAME:
                errors.append(f"{sw}: folder name must match [a-z0-9]+(-[a-z0-9]+)* and be <= {MAX_NAME} chars")
            desc = sk.meta.get("description")
            if not isinstance(desc, str) or not desc.strip():
                errors.append(f"{sw}: description is required")
            elif len(desc) > DESC_MAX:
                errors.append(f"{sw}: description is {len(desc)} chars (max {DESC_MAX})")
            elif len(desc) > DESC_WARN:
                warnings.append(f"{sw}: description is {len(desc)} chars (aim for <= {DESC_WARN})")
            if block is not None and _unquoted_colon(block, "description"):
                warnings.append(f"{sw}: description contains ': ' unquoted; strict YAML parsers reject it, quote it")
            n_lines = text.count("\n") + 1
            if n_lines >= SKILL_MAX_LINES:
                errors.append(f"{sw}: {n_lines} lines (keep SKILL.md under {SKILL_MAX_LINES}; move detail to references/)")
            if sk.name in skill_owner:
                errors.append(f"{sw}: skill name '{sk.name}' already used by bundle '{skill_owner[sk.name]}'")
            skill_owner[sk.name] = name
            for ref in sorted(set(_SCRIPT_REF.findall(text))):
                ref = ref.rstrip(".")
                if not (root / ref).exists():
                    warnings.append(f"{sw}: references {ref}, which does not exist")
        for r in b.rules:
            rw = _rel(root, r.path) if r.path else r.name
            if r.error:
                errors.append(f"{rw}: {r.error}")
                continue
            if not NAME_RE.match(r.name):
                errors.append(f"{rw}: rule file names are kebab-case")
            if r.name in rule_owner:
                errors.append(f"{rw}: rule name '{r.name}' already used by {rule_owner[r.name]}")
            rule_owner[r.name] = f"bundle '{name}'"
            if r.apply not in APPLY_MODES:
                errors.append(f"{rw}: 'apply' must be one of {', '.join(APPLY_MODES)}")
            if not r.description:
                errors.append(f"{rw}: description is required")
            if r.apply == "glob" and not r.globs:
                errors.append(f"{rw}: apply: glob needs a non-empty globs list")
            if r.apply == "always" and len(r.body.encode("utf-8")) > ALWAYS_RULE_WARN_BYTES:
                warnings.append(f"{rw}: always-on rule body is {len(r.body.encode('utf-8'))} bytes "
                                f"(keep it under {ALWAYS_RULE_WARN_BYTES}; move detail into a skill)")
        for h in b.hooks:
            hw = f"{where}/hooks.toml [{h.id}]"
            if h.id in hook_ids:
                errors.append(f"{hw}: id already used by bundle '{hook_ids[h.id]}'")
            hook_ids[h.id] = name
            if h.event not in EVENTS:
                errors.append(f"{hw}: event must be one of {', '.join(EVENTS)}")
            script = b.path / h.run
            if not h.run:
                errors.append(f"{hw}: 'run' is required")
            elif not script.is_file():
                errors.append(f"{hw}: run script {h.run} does not exist")
            elif not os.access(script, os.X_OK):
                errors.append(f"{hw}: run script {h.run} is not executable")
            if h.timeout_s <= 0:
                errors.append(f"{hw}: timeout_s must be positive")
            if h.tools is not None and any(t not in TOOLS for t in h.tools):
                errors.append(f"{hw}: tools must be a subset of {', '.join(TOOLS)}")
            unknown = set(h.match) - {"mcp", "shell", "tool"}
            if unknown:
                errors.append(f"{hw}: unknown match key(s) {', '.join(sorted(unknown))}")
            if h.match and h.event not in ("before_tool", "after_tool"):
                warnings.append(f"{hw}: 'match' only applies to before_tool and after_tool")
        for m in b.mcp:
            if not (m.spec.get("command") or m.spec.get("url")):
                errors.append(f"{where}/mcp.toml [server.{m.name}]: needs command or url")
            for key in ("command", "url"):
                val = str(m.spec.get(key, ""))
                if val.startswith("/"):
                    warnings.append(f"{where}/mcp.toml [server.{m.name}]: absolute {key}; machine paths belong "
                                    "in skeleton.local.toml [mcp.<name>]")

    # Repository-wide text checks on tracked kit content (local/ is private: em dash only, below).
    deny = _load_denylist(root)
    denylist_path = root / "tests" / "denylist.txt"
    for p in _iter_scan_files(root):
        try:
            text = p.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        rel = _rel(root, p)
        dash = _em_dash_error(root, p, text)
        if dash:
            errors.append(dash)
        if p == denylist_path:
            continue
        for pat in deny:
            m = pat.search(text)
            if m:
                line = text[:m.start()].count("\n") + 1
                errors.append(f"{rel}:{line}: matches denylist pattern {pat.pattern!r}")
    # Private bundles: only the em dash rule (their skills, rules and scripts reach agents);
    # the denylist is for the public kit and is not applied to private content.
    for p in _iter_local_scan_files(root):
        try:
            text = p.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        dash = _em_dash_error(root, p, text)
        if dash:
            errors.append(dash)
    return errors, warnings


def cmd_check(ctx: argparse.Namespace) -> int:
    errors, warnings = run_checks(ctx.root)
    for w in warnings:
        info(STYLE.yellow("⚠️  ") + w)
    for e in errors:
        info(STYLE.red("❌ ") + e)
    if errors or (ctx.strict and warnings):
        info(STYLE.red(f"❌ **check** {len(errors)} error(s), {len(warnings)} warning(s)"))
        return 1
    info(f"✅ **check** passed ({len(warnings)} warning(s))")
    return 0


def cmd_test(ctx: argparse.Namespace) -> int:
    tests = ctx.root / "tests"
    if not tests.is_dir():
        fail("tests/ not found")
    argv = [sys.executable, "-m", "unittest", "discover", "-s", str(tests), "-t", str(ctx.root),
            "-p", ctx.pattern or "test_*.py"]
    if ctx.verbose:
        argv.append("-v")
    env = dict(os.environ)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    return subprocess.call(argv, cwd=str(ctx.root), env=env)


# --------------------------------------------------------------------------- #
# Entry point
# --------------------------------------------------------------------------- #

def default_root() -> Path:
    env = os.environ.get("SKELETON_ROOT")
    if env:
        return Path(env).resolve()
    return Path(os.path.abspath(__file__)).resolve().parent.parent


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="skeleton",
        description="Render the agent-skeleton kit for Claude Code, Cursor, Gemini CLI and Antigravity.")
    p.add_argument("--root", type=Path, default=None, help="repository root (default: this checkout)")
    p.add_argument("--no-color", action="store_true", help="disable colored output")
    p.add_argument("--version", action="version", version=f"agent-skeleton {VERSION}")
    sub = p.add_subparsers(dest="command", metavar="<command>")

    s = sub.add_parser("init", help="render every generated file (idempotent)")
    s.add_argument("--tools", help="comma-separated subset for this run, e.g. claude,cursor")
    s.add_argument("--force", action="store_true", help="overwrite files that skeleton did not create")
    s.add_argument("--check", action="store_true", help="only report whether the generated tree is stale")
    s.add_argument("-v", "--verbose", action="store_true", help="list written and pruned paths")
    s.set_defaults(func=cmd_init)

    s = sub.add_parser("doctor", help="check dependencies, config files and generated tree freshness")
    s.set_defaults(func=cmd_doctor)

    s = sub.add_parser("list", help="show bundles and skills with their state")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--bundles", action="store_true", help="bundles only")
    g.add_argument("--skills", action="store_true", help="skills only")
    s.add_argument("--names", action="store_true", help="print bundle names only (for scripts)")
    s.add_argument("--enabled", action="store_true", help="with --names: enabled bundles only")
    s.set_defaults(func=cmd_list)

    for verb, on in (("enable", True), ("disable", False)):
        s = sub.add_parser(verb, help=f"{verb} a bundle, skill, rule or hook in skeleton.local.toml")
        s.add_argument("target")
        s.add_argument("--kind", choices=KINDS, help="disambiguate when names collide")
        s.add_argument("--no-init", action="store_true", help="do not re-render afterwards")
        s.set_defaults(func=lambda c, on=on: cmd_toggle(c, on))

    s = sub.add_parser("setup", help="run a bundle's interactive setup.sh")
    s.add_argument("bundle")
    s.add_argument("args", nargs=argparse.REMAINDER)
    s.set_defaults(func=cmd_setup)

    s = sub.add_parser("projects", help="link repositories into projects/ (add, remove, list, sync)")
    s.add_argument("action", choices=("add", "remove", "list", "sync"))
    s.add_argument("names", nargs="*")
    s.set_defaults(func=cmd_projects)

    s = sub.add_parser("new-skill", help="scaffold kit/bundles/<bundle>/skills/<name>/SKILL.md")
    s.add_argument("bundle")
    s.add_argument("name")
    s.add_argument("--description", help="frontmatter description")
    s.add_argument("--user-invocable", action="store_true",
                   help="slash-command style skill (disable-model-invocation: true)")
    s.set_defaults(func=cmd_new_skill)

    s = sub.add_parser("check", help="lint bundles, skills, rules, hooks and text")
    s.add_argument("--strict", action="store_true", help="treat warnings as errors")
    s.set_defaults(func=cmd_check)

    s = sub.add_parser("test", help="run the test suite in tests/")
    s.add_argument("-v", "--verbose", action="store_true")
    s.add_argument("-k", "--pattern", help="file pattern (default test_*.py)")
    s.set_defaults(func=cmd_test)
    return p


def main(argv: list[str] | None = None) -> int:
    global STYLE
    parser = build_parser()
    args = parser.parse_args(argv)
    color = sys.stdout.isatty() and not args.no_color and not os.environ.get("NO_COLOR")
    STYLE = Style(color)
    args.root = (args.root.expanduser().resolve() if args.root else default_root())
    if not getattr(args, "command", None):
        parser.print_help()
        return 0
    return int(args.func(args) or 0)


if __name__ == "__main__":
    sys.exit(main())
