{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "plansDirectory": "plans",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate)",
      "Bash(terraform validate *)",
      "Bash(terraform plan)",
      "Bash(terraform plan *)",
      "Bash(terraform show *)",
      "Bash(terraform version)",
      "Bash(gcloud * describe *)",
      "Bash(gcloud * list *)",
      "Bash(gcloud config list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(bin/skeleton list *)",
      "Bash(bin/skeleton doctor)",
      "Bash(bin/skeleton check *)",
      "Bash(bin/skeleton init --check)"
    ],
    "deny": [
      "Bash(terraform apply)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy)",
      "Bash(terraform destroy *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(gcloud projects create *)",
      "Bash(gcloud projects delete *)"
    ]
  }
}
