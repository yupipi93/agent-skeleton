#!/usr/bin/env bash
# Run jsm-portal-requests. `jpr install` creates its venv (Playwright only; no
# browser download, it drives the Google Chrome already installed).
set -euo pipefail

TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
JPR_HOME="${JPR_HOME:-$HOME/.local/share/jsm-portal-requests}"
VENV="$JPR_HOME/venv"

if [ "${1:-}" = "install" ]; then
  PY="${JPR_PYTHON:-python3}"
  if ! "$PY" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)'; then
    echo "jpr: needs Python 3.11 or newer ($PY); set JPR_PYTHON" >&2
    exit 2
  fi
  mkdir -p "$JPR_HOME"
  chmod 700 "$JPR_HOME"
  "$PY" -m venv "$VENV"
  "$VENV/bin/pip" install --quiet --upgrade pip
  "$VENV/bin/pip" install --quiet -r "$TOOL_DIR/requirements.txt"
  echo "installed in $VENV"
  exit 0
fi

PY="$VENV/bin/python"
[ -x "$PY" ] || PY="${JPR_PYTHON:-python3}"
PYTHONPATH="$TOOL_DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$PY" -m jpr "$@"
